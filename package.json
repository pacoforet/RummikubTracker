{
  "name": "rummikub-tracker",
  "version": "2.1.0",
  "description": "A mobile-first PWA for tracking Rummikub game scores",
  "main": "js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" sw.js \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" sw.js \"css/**/*.css\"",
    "check": "npm run lint && npm run format:check && npm test",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [
    "rummikub",
    "score-tracker",
    "pwa",
    "game"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=20"
  }
}
